{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build --config build/vercel.config.js",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__phantom_route=:path*" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@meri-imperiumi/eccodes-wasm/{wasm,build}/**",
      "excludeFiles": "{.env*,.git/**,.agents/**,.codex/**,qa-artifacts/**,qa-shots/**,**/*.test.mjs}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
